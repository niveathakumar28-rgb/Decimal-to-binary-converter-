#include <stdio.h>

int main()
{
    int n, remainder;
    int binary[32];
    int i = 0;

    printf("Enter a decimal number: ");
    scanf("%d", &n);

    if (n == 0)
    {
        printf("Binary equivalent = 0\n");
    }
    else if (n < 0)
    {
        printf("Please enter a positive decimal number.\n");
    }
    else
    {
        while (n > 0)
        {
            remainder = n % 2;
            binary[i] = remainder;
            i++;
            n = n / 2;
        }

        printf("Binary equivalent = ");

        for (i = i - 1; i >= 0; i--)
        {
            printf("%d", binary[i]);
        }

        printf("\n");
    }

    return 0;
}
